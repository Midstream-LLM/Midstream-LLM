{
  "model": {
    "name": "Jishui-Debug",
    "vocab_size": 32768,
    "hidden_size": 128,
    "num_hidden_layers": 2,
    "num_attention_heads": 4,
    "num_key_value_heads": 4,
    "head_dim": 32,
    "intermediate_size": 352,
    "norm_type": "layernorm",
    "norm_eps": 1e-5,
    "norm_bias": true,
    "rope_theta": 10000,
    "max_position_embeddings": 128,
    "tie_word_embeddings": true,
    "attention_bias": false,
    "mlp_bias": false,
    "gradient_checkpointing": false
  },
  "training": {
    "seed": 42,
    "dtype": "float32",
    "seq_len": 64,
    "batch_size": 1,
    "grad_accum_steps": 1,
    "max_steps": 2,
    "learning_rate": 0.001,
    "min_learning_rate": 0.0001,
    "warmup_steps": 1,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.95,
    "adam_eps": 0.00001,
    "grad_clip": 1.0,
    "log_interval": 1,
    "eval_interval": 1,
    "eval_batches": 1,
    "save_interval": 1,
    "sampling_mode": "target",
    "eod_token_id": 2,
    "compile_step": true
  }
}
