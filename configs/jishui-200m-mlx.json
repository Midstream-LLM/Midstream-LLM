{
  "model": {
    "name": "Jishui-200M-Base",
    "vocab_size": 32768,
    "hidden_size": 704,
    "num_hidden_layers": 30,
    "num_attention_heads": 11,
    "num_key_value_heads": 11,
    "head_dim": 64,
    "intermediate_size": 1856,
    "norm_type": "layernorm",
    "norm_eps": 1e-5,
    "norm_bias": true,
    "rope_theta": 10000,
    "max_position_embeddings": 2048,
    "tie_word_embeddings": true,
    "attention_bias": false,
    "mlp_bias": false,
    "gradient_checkpointing": false
  },
  "training": {
    "seed": 42,
    "dtype": "float16",
    "seq_len": 2048,
    "batch_size": 1,
    "grad_accum_steps": 8,
    "max_steps": 61036,
    "learning_rate": 0.0003,
    "min_learning_rate": 0.00003,
    "warmup_steps": 200,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "adam_eps": 0.00001,
    "grad_clip": 1.0,
    "log_interval": 1,
    "eval_interval": 200,
    "eval_batches": 10,
    "save_interval": 400,
    "max_checkpoints": 3,
    "optimizer_checkpoints": 3,
    "sampling_mode": "target",
    "eod_token_id": 2,
    "compile_step": true
  }
}
